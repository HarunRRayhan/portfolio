# Bluesky app password (announces new blog posts)
#
# Real file (gitignored): .secrets/bluesky.env
#   cp .secrets/bluesky.env.example .secrets/bluesky.env
#
# Handle without the @, e.g. harun.dev or harun.bsky.social
# Create the app password at https://bsky.app/settings/app-passwords (never your main password)

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
