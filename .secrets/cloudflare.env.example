CLOUDFLARE_PERM_ZONE_SETTINGS=Zone.Zone Settings:Edit
CLOUDFLARE_PERM_BOT_MANAGEMENT=Zone.Bot Management:Edit
CLOUDFLARE_PERM_AI_CRAWL_CONTROL=Zone.AI Crawl Control:Edit
CLOUDFLARE_PERM_CACHE_PURGE=Zone.Cache Purge:Purge
CLOUDFLARE_PERM_WAF=Zone.Firewall Services:Edit
CLOUDFLARE_PERM_ANALYTICS=Zone.Analytics:Read
CLOUDFLARE_PERM_DNS=Zone.DNS:Read
