# Google Calendar + Meet OAuth for paid consultations
#
# Real file (gitignored): .secrets/google-calendar.env
#   cp .secrets/google-calendar.env.example .secrets/google-calendar.env
#
# Never commit google-calendar.env. Only *.example files under .secrets/ are tracked.
#
# OAuth Web client redirect: {APP_URL}/admin/consultations/google/callback
# Scopes: calendar, calendar.events, meetings.space.settings,
#         meetings.space.created, userinfo.email
#
# If empty, app falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (site login).

CONSULTATION_GOOGLE_CLIENT_ID=
CONSULTATION_GOOGLE_CLIENT_SECRET=
CONSULTATION_GOOGLE_REDIRECT_URI=
CONSULTATION_GOOGLE_CALENDAR_ID=primary
CONSULTATION_SCHEDULE_TIMEZONE=UTC
