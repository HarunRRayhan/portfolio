# Hashnode API token + publication (blog cross-posting)
#
# Real file (gitignored): .secrets/hashnode.env
#   cp .secrets/hashnode.env.example .secrets/hashnode.env
#
# Token: https://hashnode.com/settings/developer
# Publication id is optional: with exactly one Hashnode blog it is looked up from the token.
# Set it only if the account owns several blogs (it picks which one gets the post).

HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
