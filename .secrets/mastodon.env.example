# Mastodon access token (announces new blog posts)
#
# Real file (gitignored): .secrets/mastodon.env
#   cp .secrets/mastodon.env.example .secrets/mastodon.env
#
# Instance origin, e.g. https://mastodon.social
# Token: Preferences > Development > New application, scope write:statuses only

MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
