{
    admin off
    persist_config off
    auto_https off

    {$CADDY_GLOBAL_OPTIONS}

    log {
        format json
        output stderr
    }

    frankenphp {
        {$FRANKENPHP_CONFIG}
    }
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
    root * /app/public
    encode zstd br gzip

    # Only existing, content-hashed build assets get immutable caching.
    # Missing assets and Laravel responses must not inherit this policy.
    @versionedAssets {
        path /build/assets/*
        file
    }
    header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

    file_server {
        hide .git
        hide .env*
    }

    {$CADDY_SERVER_EXTRA_DIRECTIVES}

    php_server
}
